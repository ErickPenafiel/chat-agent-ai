# ==============================================================================
# Frontend Environment Configuration - Template (.env.example)
# ==============================================================================
# Copia este archivo como .env para desarrollo local:
#   cp .env.example .env
# ==============================================================================

# URL base del Backend API de FastAPI.
# Dejar vacío "" en desarrollo local para utilizar el proxy automático de Vite (puerto 5173 -> 8000).
# Para apuntar directamente al backend en producción o staging: http://localhost:8000
VITE_API_URL=

# Título de la aplicación en la interfaz web
VITE_APP_TITLE=Agente IA - Panel de Configuración
