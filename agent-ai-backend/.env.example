# ==============================================================================
# Backend Environment Configuration - Template (.env.example)
# ==============================================================================
# Copia este archivo como .env y completa los valores correspondientes:
#   cp .env.example .env
# ==============================================================================

# --- Entorno y Servidor ---
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000

# --- Configuración del Inquilino (Tenant) ---
# Ruta al archivo YAML que define la personalidad, herramientas y canal del agente.
# Ejemplos:
#   - examples/coffee-shop/tenant.yaml (Ejemplo listo para probar)
#   - config/tenant.yaml (Configuración principal)
TENANT_CONFIG=examples/coffee-shop/tenant.yaml

# --- Base de Datos (SQLAlchemy) ---
# SQLite local:
DATABASE_URL=sqlite:///./demo.db
# PostgreSQL de producción:
# DATABASE_URL=postgresql+psycopg://usuario:password@localhost:5432/agente_db

# --- Seguridad y Autenticación Administrativa ---
# En desarrollo local: 1 permite acceder a endpoints de administración sin token Firebase.
# En producción: 0 o no definida (requiere autenticación Firebase si auth.mode=firebase).
ALLOW_INSECURE_AUTH=1

# ==============================================================================
# Proveedores de LLM (Configura el correspondiente según tenant.yaml -> llm.provider)
# ==============================================================================

# 1. Groq Cloud (Ultra rápida inferencia con Llama 3 / Mixtral / etc.)
# Obtén tu clave en: https://console.groq.com/keys
GROQ_API_KEY=gsk_tu_clave_aqui

# 2. Google Gemini (Google AI Studio)
# Obtén tu clave en: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=tu_google_api_key_aqui

# 3. Anthropic Claude
# Obtén tu clave en: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-tu_anthropic_api_key_aqui

# ==============================================================================
# Canales de Mensajería (Opcional si usas canal Web)
# ==============================================================================

# Meta / WhatsApp Cloud API (Requerido solo si channels incluye whatsapp_cloud_api)
WHATSAPP_TOKEN=tu_meta_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=tu_phone_number_id
WHATSAPP_APP_SECRET=tu_app_secret_para_verificar_hmac
WHATSAPP_VERIFY_TOKEN=tu_token_personalizado_para_webhook_challenge
