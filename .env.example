# ==============================================================================
# Agente IA Genérico - Variables de Entorno Globales (.env.example)
# ==============================================================================
# Este proyecto cuenta con dos entornos principales:
# 1. Backend (FastAPI / Python): configurado en `agent-ai-backend/.env`
# 2. Frontend (React 19 / Vite): configurado en `agent-ai-frontend/.env`
# ==============================================================================

# --- BACKEND ---
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
TENANT_CONFIG=examples/coffee-shop/tenant.yaml
DATABASE_URL=sqlite:///./demo.db
ALLOW_INSECURE_AUTH=1

# Proveedores de LLM:
GROQ_API_KEY=gsk_tu_clave_groq_aqui
GOOGLE_API_KEY=tu_clave_gemini_aqui
ANTHROPIC_API_KEY=tu_clave_anthropic_aqui

# Meta / WhatsApp Cloud API:
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# --- FRONTEND ---
VITE_API_URL=http://localhost:8000

# Jev (TypeSafe AI), opcional:
TYPESAFE_API_KEY=
